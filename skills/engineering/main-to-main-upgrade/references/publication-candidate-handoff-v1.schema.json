{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vllm-cl-publication-candidate-handoff/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "producer", "publication_proposed", "tested_revision", "publication_candidate", "generated_at", "expires_at", "finalize_action", "claim_boundary", "digest"],
  "properties": {
    "schema_version": {"const": "vllm-cl-publication-candidate-handoff/v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "authority_id", "produces_handoff_only", "self_approval"],
      "properties": {
        "workflow": {"const": "externally-authorized-publication-preparation"},
        "authority_id": {"type": "string", "minLength": 1},
        "produces_handoff_only": {"const": true},
        "self_approval": {"const": false}
      }
    },
    "publication_proposed": {"type": "boolean"},
    "tested_revision": {"$ref": "#/$defs/testedRevision"},
    "publication_candidate": {"oneOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "finalize_action": {"const": "none"},
    "claim_boundary": {"type": "string", "pattern": "^Claim Boundary:"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [{
    "if": {"properties": {"publication_proposed": {"const": true}}},
    "then": {"properties": {"publication_candidate": {"$ref": "#/$defs/candidate"}}},
    "else": {"properties": {"publication_candidate": {"type": "null"}}}
  }],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "testedRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_sha", "commit_sha", "tree_sha", "worktree_clean", "artifact_graph_digest"],
      "properties": {
        "repository": {"const": "vllm-cl"},
        "base_sha": {"$ref": "#/$defs/sha"},
        "commit_sha": {"$ref": "#/$defs/sha"},
        "tree_sha": {"$ref": "#/$defs/sha"},
        "worktree_clean": {"type": "boolean"},
        "artifact_graph_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_sha", "commit_sha", "tree_sha", "worktree_clean", "created_at", "included_paths", "excluded_paths", "scoped_diff_digest", "scoped_tree_digest", "patch_equivalence", "artifact_graph_digest", "rebuilt_artifact_refs", "affected_gate_refs", "remote_observation", "lease", "rewrite_required", "authorization_refs"],
      "properties": {
        "repository": {"const": "vllm-cl"},
        "base_sha": {"$ref": "#/$defs/sha"},
        "commit_sha": {"$ref": "#/$defs/sha"},
        "tree_sha": {"$ref": "#/$defs/sha"},
        "worktree_clean": {"const": true},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "included_paths": {"$ref": "#/$defs/paths"},
        "excluded_paths": {"$ref": "#/$defs/paths"},
        "scoped_diff_digest": {"$ref": "#/$defs/digest"},
        "scoped_tree_digest": {"$ref": "#/$defs/digest"},
        "patch_equivalence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "tested_scoped_diff_digest", "candidate_scoped_diff_digest"],
          "properties": {
            "method": {"const": "scoped-git-diff-sha256"},
            "tested_scoped_diff_digest": {"$ref": "#/$defs/digest"},
            "candidate_scoped_diff_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "artifact_graph_digest": {"$ref": "#/$defs/digest"},
        "rebuilt_artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}},
        "affected_gate_refs": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}},
        "remote_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_base_ref", "target_base_sha", "pr_tip_ref", "pr_tip_sha", "observed_at"],
          "properties": {
            "target_base_ref": {"type": "string", "pattern": "^refs/(?!-)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
            "target_base_sha": {"$ref": "#/$defs/sha"},
            "pr_tip_ref": {"type": "string", "pattern": "^refs/(?!-)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
            "pr_tip_sha": {"$ref": "#/$defs/sha"},
            "observed_at": {"$ref": "#/$defs/timestamp"}
          }
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_base_expected_old_sha", "pr_tip_expected_old_sha"],
          "properties": {
            "target_base_expected_old_sha": {"$ref": "#/$defs/sha"},
            "pr_tip_expected_old_sha": {"$ref": "#/$defs/sha"}
          }
        },
        "rewrite_required": {"type": "boolean"},
        "authorization_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRef"}}
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!-)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\x00]+$"}
    }
  }
}
