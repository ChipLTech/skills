{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vllm-cl-publication-candidate-assessment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "publication_verification", "publication_eligible", "authorization_status", "checks", "primary_blocker", "finalize_action", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "vllm-cl-publication-candidate-assessment/v1"},
    "status": {"enum": ["assessment_complete", "not_proposed", "blocked"]},
    "publication_verification": {"const": "not_verified_for_publication"},
    "publication_eligible": {"const": false},
    "authorization_status": {"const": "human_authorization_required"},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "primary_blocker": {"oneOf": [{"$ref": "#/$defs/check"}, {"type": "null"}]},
    "handoff_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "finalize_action": {"const": "none"},
    "claim_boundary": {"type": "string", "pattern": "^Claim Boundary:"},
    "repository_before": {"$ref": "#/$defs/repositories"},
    "repository_after": {"$ref": "#/$defs/repositories"},
    "error": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "path"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "blocked"]},
        "path": {"type": "string", "pattern": "^\\$"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree", "status_digest", "tracked_diff_digest", "index_diff_digest"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tracked_diff_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "index_diff_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/snapshot"},
      "minProperties": 2
    }
  }
}
