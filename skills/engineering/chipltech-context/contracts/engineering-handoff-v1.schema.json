{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-handoff/v1",
  "title": "Engineering Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "task_id", "objective", "current_state", "fact_baseline_references", "decision_references", "evidence_return_references", "failed_attempts_not_to_repeat", "context_package_reference", "next", "authorizations_still_required", "invalidation_conditions", "claim_boundary", "digest"],
  "properties": {
    "schema_version": {"const": "engineering-handoff/v1"},
    "handoff_id": {"$ref": "#/$defs/nonEmpty"}, "task_id": {"$ref": "#/$defs/nonEmpty"},
    "objective": {"$ref": "#/$defs/nonEmpty"}, "current_state": {"$ref": "#/$defs/nonEmpty"},
    "fact_baseline_references": {"$ref": "#/$defs/references"}, "decision_references": {"$ref": "#/$defs/references"},
    "evidence_return_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "failed_attempts_not_to_repeat": {"$ref": "#/$defs/strings"},
    "context_package_reference": {"$ref": "#/$defs/reference"},
    "next": {"type": "object", "additionalProperties": false, "required": ["owner", "action", "criterion", "stop_conditions"], "properties": {"owner": {"$ref": "#/$defs/nonEmpty"}, "action": {"$ref": "#/$defs/nonEmpty"}, "criterion": {"$ref": "#/$defs/nonEmpty"}, "stop_conditions": {"$ref": "#/$defs/strings"}}},
    "authorizations_still_required": {"$ref": "#/$defs/strings"}, "invalidation_conditions": {"$ref": "#/$defs/strings"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"}, "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claimBoundary": {"type": "string", "pattern": "^Claim Boundary: Establishes [^;\\r\\n]+; does not establish [^\\r\\n]+$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "schema_version", "uri", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/nonEmpty"}, "schema_version": {"$ref": "#/$defs/nonEmpty"}, "uri": {"$ref": "#/$defs/nonEmpty"}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
