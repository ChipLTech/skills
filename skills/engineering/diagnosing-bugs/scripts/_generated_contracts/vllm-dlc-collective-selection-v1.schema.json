{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vllm-dlc-collective-selection/v1",
  "title": "vLLM-DLC Collective Selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["selector", "topology_digest", "payload_bytes", "constraints", "rank_domain", "rank_order", "strategy", "cache_key_digest", "fallback"],
  "properties": {
    "selector": {"$ref": "#/$defs/selector"},
    "topology_digest": {"$ref": "#/$defs/digest"},
    "payload_bytes": {"type": "integer", "minimum": 0},
    "constraints": {"$ref": "#/$defs/constraints"},
    "rank_domain": {"$ref": "#/$defs/rankDomain"},
    "rank_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "strategy": {"$ref": "#/$defs/strategy"},
    "cache_key_digest": {"$ref": "#/$defs/digest"},
    "fallback": {"$ref": "#/$defs/fallback"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha", "binary_sha256", "symbol"],
      "properties": {
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "binary_sha256": {"$ref": "#/$defs/digest"},
        "symbol": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["min_payload_bytes", "max_payload_bytes", "payload_alignment_bytes", "dtypes", "layouts", "actual_layout"],
      "properties": {
        "min_payload_bytes": {"type": "integer", "minimum": 0},
        "max_payload_bytes": {"type": "integer", "minimum": 0},
        "payload_alignment_bytes": {"type": "integer", "minimum": 1},
        "dtypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "layouts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "actual_layout": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "rankDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "primary_root", "secondary_root", "logical_to_physical"],
      "properties": {
        "domain": {"enum": ["communicator_local", "logical", "physical"]},
        "primary_root": {"type": "integer", "minimum": 0},
        "secondary_root": {"type": ["integer", "null"], "minimum": 0},
        "logical_to_physical": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy_id", "consumer_route_id", "metadata_abi_digest", "rank_domain", "requires_secondary_root"],
      "properties": {
        "strategy_id": {"$ref": "#/$defs/nonEmpty"},
        "consumer_route_id": {"$ref": "#/$defs/nonEmpty"},
        "metadata_abi_digest": {"$ref": "#/$defs/digest"},
        "rank_domain": {"enum": ["communicator_local", "logical", "physical"]},
        "requires_secondary_root": {"type": "boolean"}
      }
    },
    "fallback": {
      "type": "object", "additionalProperties": false,
      "required": ["preferred_strategy_id", "candidate_strategy_id", "validation_state", "validation", "committed"],
      "properties": {
        "preferred_strategy_id": {"$ref": "#/$defs/nonEmpty"},
        "candidate_strategy_id": {"$ref": "#/$defs/nonEmpty"},
        "validation_state": {"enum": ["unknown", "validating", "passed", "failed"]},
        "validation": {"$ref": "#/$defs/fallbackValidation"},
        "committed": {"type": "boolean"}
      }
    },
    "fallbackValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["graph", "channel", "rank_order", "rank_range", "unique_ranks", "root_metadata", "payload", "alignment"],
      "properties": {
        "graph": {"type": "boolean"},
        "channel": {"type": "boolean"},
        "rank_order": {"type": "boolean"},
        "rank_range": {"type": "boolean"},
        "unique_ranks": {"type": "boolean"},
        "root_metadata": {"type": "boolean"},
        "payload": {"type": "boolean"},
        "alignment": {"type": "boolean"}
      }
    }
  }
}
