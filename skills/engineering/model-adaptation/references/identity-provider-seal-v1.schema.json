{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vllm-dlc-identity-provider-seal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seal_id", "provider", "subject_class", "observed_value", "generation", "observed_at", "expires_at", "raw_evidence_digest", "authoritativeness", "status", "blockers", "primary_blocker", "claim_boundary", "unverified_scope", "digest"],
  "properties": {
    "schema_version": {"const": "vllm-dlc-identity-provider-seal/v1"},
    "seal_id": {"type": "string", "minLength": 1},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "identity_digest"],
      "properties": {
        "id": {"const": "model-adaptation/python-package-identity-provider"},
        "version": {"const": "1.0.0"},
        "identity_digest": {"const": "sha256:5e61c613ee2db3fbbf234d37b259853cebffc84d2b61058fa52aea212cafee92"}
      }
    },
    "subject_class": {"const": "installed_package"},
    "observed_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "digest": {"$ref": "#/$defs/digest"},
        "native_binary_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "atomic"],
      "properties": {
        "kind": {"enum": ["transaction_id", "immutable_generation", "content_snapshot"]},
        "value": {"type": "string", "minLength": 1},
        "atomic": {"type": "boolean"}
      }
    },
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "raw_evidence_digest": {"$ref": "#/$defs/digest"},
    "authoritativeness": {"enum": ["non_authoritative", "operational"]},
    "status": {"enum": ["blocked", "not_verified"]},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "primary_blocker": {"oneOf": [{"$ref": "#/$defs/blocker"}, {"type": "null"}]},
    "claim_boundary": {"type": "string", "pattern": "^Claim Boundary:"},
    "unverified_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_verified"}}},
      "then": {
        "properties": {
          "observed_value": {
            "required": ["name", "version", "path", "digest", "native_binary_digests"]
          }
        }
      }
    },
    {
      "if": {"properties": {"generation": {"properties": {"kind": {"const": "content_snapshot"}}}}},
      "then": {"properties": {"generation": {"properties": {"atomic": {"const": false}}}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code", "path"],
      "properties": {
        "status": {"enum": ["blocked", "not_verified"]},
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^\\$"}
      }
    }
  }
}
